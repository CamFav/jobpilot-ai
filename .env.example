# Copy this file to .env for local development once local services exist.
# Do not put real credentials in this file or commit your .env file.

# PostgreSQL (local Docker Compose service)
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Backend (Spring Boot service)
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/jobpilot
DATABASE_USERNAME=jobpilot
DATABASE_PASSWORD=change-me-locally

# AI providers: set only in your untracked local .env file
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# n8n (future local service)
N8N_ENCRYPTION_KEY=change-me-locally
